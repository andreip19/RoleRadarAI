# Backend runtime configuration
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
ADMIN_API_TOKEN=development-only-placeholder
# Comma-separated browser origins. Development also allows localhost:5173.
CORS_ORIGINS=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
